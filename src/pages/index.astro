---
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>California Tax Withholding Estimator · 2026</title>
  </head>
  <body>
    <main>
      <header class="progress-wrap">
        <div class="progress-label" id="progress-label">Get started</div>
        <div class="progress-track"><div class="progress-fill" id="progress-fill"></div></div>
      </header>

      <section class="step card" data-title="Welcome">
        <h1>California Tax Withholding Estimator</h1>
        <p>
          Answer a few questions about your 2026 tax situation and we'll project exactly whether
          you're on track to <b>overpay</b> or <b>underpay</b> federal and California income tax —
          and what to change to fix it.
        </p>
        <p class="muted">Takes about 3 minutes. Nothing is stored or sent anywhere.</p>
        <div class="nav">
          <button type="button" class="btn primary" id="start-btn">Get started</button>
        </div>
      </section>

      <section class="step card hidden" data-title="About You">
        <h2>About You</h2>
        <p class="muted">
          Tell us about yourself. Your responses will help us learn which tax benefits you could be
          eligible for, which can impact how much tax you withhold.
        </p>

        <fieldset class="q">
          <legend>Will you be 65 years old or older on January 1, 2027? <span class="req">Required</span></legend>
          <div class="choice">
            <label><input type="radio" name="age65" value="yes" /><span>Yes</span></label>
            <label><input type="radio" name="age65" value="no" /><span>No</span></label>
          </div>
        </fieldset>

        <fieldset class="q">
          <legend>Are you blind? <span class="req">Required</span></legend>
          <div class="choice">
            <label><input type="radio" name="blind" value="yes" /><span>Yes</span></label>
            <label><input type="radio" name="blind" value="no" /><span>No</span></label>
          </div>
        </fieldset>

        <fieldset class="q">
          <legend>Do you plan to claim dependents on your 2026 tax return? <span class="req">Required</span></legend>
          <details class="hint">
            <summary>Who can I claim as a dependent?</summary>
            <p>A qualifying child or qualifying relative who meets the IRS tests: they rely on you for more than half their support, meet relationship, age, residency, and income rules, and aren't claimed by someone else.</p>
          </details>
          <div class="choice">
            <label><input type="radio" name="dependents" value="yes" /><span>Yes</span></label>
            <label><input type="radio" name="dependents" value="no" /><span>No</span></label>
          </div>
          <div id="dependents-block" class="sub-block hidden">
            <label class="field">
              <span class="field-label">Dependents under age 17 (for the Child Tax Credit)</span>
              <input type="number" id="children-under17" min="0" max="20" step="1" placeholder="0" />
            </label>
            <label class="field">
              <span class="field-label">Other dependents (age 17+, or adult relatives)</span>
              <input type="number" id="other-dependents" min="0" max="20" step="1" placeholder="0" />
            </label>
          </div>
        </fieldset>

        <fieldset class="q">
          <legend>Can you be claimed as a dependent on someone else's 2026 tax return? <span class="req">Required</span></legend>
          <details class="hint">
            <summary>How do I know if I'm someone's dependent?</summary>
            <p>If someone provides more than half of your financial support and you meet the IRS dependency tests (income, age, residency), they may be able to claim you.</p>
          </details>
          <div class="choice">
            <label><input type="radio" name="isDependent" value="yes" /><span>Yes</span></label>
            <label><input type="radio" name="isDependent" value="no" /><span>No</span></label>
          </div>
        </fieldset>

        <fieldset class="q">
          <legend>Which filing status will you use to file federal taxes in 2026? <span class="req">Required</span></legend>
          <details class="hint">
            <summary>Which filing status should I use?</summary>
            <p>Generally based on your marital status on December 31, 2026. Head of Household and Qualified Surviving Spouse have additional IRS requirements.</p>
          </details>
          <label class="field">
            <select id="filing-status">
              <option value="">Choose a filing status…</option>
              <option value="single">Single</option>
              <option value="mfj">Married Filing Jointly</option>
              <option value="mfs">Married Filing Separately</option>
              <option value="hoh">Head of Household</option>
              <option value="qss">Qualified Surviving Spouse</option>
            </select>
          </label>
        </fieldset>

        <div id="spouse-block" class="sub-block hidden">
          <p class="spouse-note">If you plan to file using Married Filing Jointly, we need to ask more questions about your spouse.</p>

          <fieldset class="q">
            <legend>Will your spouse be 65 years old or older on January 1, 2027? <span class="req">Required</span></legend>
            <div class="choice">
              <label><input type="radio" name="s_age65" value="yes" /><span>Yes</span></label>
              <label><input type="radio" name="s_age65" value="no" /><span>No</span></label>
            </div>
          </fieldset>

          <fieldset class="q">
            <legend>Is your spouse blind? <span class="req">Required</span></legend>
            <div class="choice">
              <label><input type="radio" name="s_blind" value="yes" /><span>Yes</span></label>
              <label><input type="radio" name="s_blind" value="no" /><span>No</span></label>
            </div>
          </fieldset>

          <fieldset class="q">
            <legend>Can your spouse be claimed as a dependent on someone else's 2026 tax return? <span class="req">Required</span></legend>
            <details class="hint">
              <summary>How do I know if my spouse could be a dependent?</summary>
              <p>The same IRS dependency tests apply — someone else must provide more than half of your spouse's support and meet the qualifying tests.</p>
            </details>
            <div class="choice">
              <label><input type="radio" name="s_dependent" value="yes" /><span>Yes</span></label>
              <label><input type="radio" name="s_dependent" value="no" /><span>No</span></label>
            </div>
          </fieldset>
        </div>

        <p class="error hidden" id="err-1"></p>
        <div class="nav">
          <button type="button" class="btn nav-back">Back</button>
          <button type="button" class="btn primary nav-next">Continue</button>
        </div>
      </section>

      <section class="step card hidden" data-title="Income So Far">
        <h2>Income So Far</h2>
        <p class="muted">Everything so far in 2026, from your last paystub (year-to-date amounts).</p>

        <label class="field">
          <span class="field-label">How much have you made this year total (gross, before taxes)? <span class="req">Required</span></span>
          <span class="money"><span class="prefix">$</span><input type="number" id="ytd-gross" min="0" step="0.01" placeholder="0.00" /></span>
        </label>

        <label class="field">
          <span class="field-label">How much have you paid in California taxes so far? <span class="req">Required</span></span>
          <span class="money"><span class="prefix">$</span><input type="number" id="ytd-ca" min="0" step="0.01" placeholder="0.00" /></span>
        </label>

        <label class="field">
          <span class="field-label">How much have you paid in federal taxes so far? <span class="req">Required</span></span>
          <span class="money"><span class="prefix">$</span><input type="number" id="ytd-fed" min="0" step="0.01" placeholder="0.00" /></span>
        </label>

        <p class="error hidden" id="err-2"></p>
        <div class="nav">
          <button type="button" class="btn nav-back">Back</button>
          <button type="button" class="btn primary nav-next">Continue</button>
        </div>
      </section>

      <section class="step card hidden" data-title="Your Paycheck">
        <h2>Your Paycheck</h2>
        <p class="muted">How you're normally paid, so we can project the rest of 2026.</p>

        <label class="field">
          <span class="field-label">When did you last get paid? <span class="req">Required</span></span>
          <input type="date" id="last-pay-date" />
          <span class="muted small">We'll anchor your pay schedule to this date to find your next payday and count how many paychecks are left in 2026.</span>
        </label>

        <label class="field">
          <span class="field-label">What day are you normally paid? <span class="req">Required</span></span>
          <select id="pay-freq">
            <option value="">Choose a pay frequency…</option>
            <option value="weekly">Weekly</option>
            <option value="biweekly">Every 2 weeks (biweekly)</option>
            <option value="monthly">Monthly</option>
          </select>
        </label>

        <label class="field">
          <span class="field-label">How much do you make before taxes, per paycheck? <span class="req">Required</span></span>
          <span class="money"><span class="prefix">$</span><input type="number" id="gross-per-period" min="0" step="0.01" placeholder="0.00" /></span>
        </label>

        <label class="field">
          <span class="field-label">Federal tax typically taken out per paycheck <span class="req">Required</span></span>
          <span class="money"><span class="prefix">$</span><input type="number" id="fed-wh-per-period" min="0" step="0.01" placeholder="0.00" /></span>
        </label>

        <label class="field">
          <span class="field-label">California tax typically taken out per paycheck <span class="req">Required</span></span>
          <span class="money"><span class="prefix">$</span><input type="number" id="ca-wh-per-period" min="0" step="0.01" placeholder="0.00" /></span>
        </label>

        <p class="error hidden" id="err-3"></p>
        <div class="nav">
          <button type="button" class="btn nav-back">Back</button>
          <button type="button" class="btn primary nav-next">Continue</button>
        </div>
      </section>

      <section class="step card hidden" data-title="Upcoming Vests">
        <h2>Upcoming Vests <span class="optional">Optional</span></h2>
        <p class="muted">
          Enter any upcoming equity vests — date and dollar amount. Add as many as you want. Vest
          amounts are taxed as ordinary income when they vest.
        </p>

        <div class="sub-block">
          <p class="sub-title">Withholding on vests</p>
          <p class="muted small">
            By default we assume <b>40%</b> of each vest is withheld when it vests (the typical provider default),
            split between federal and CA in the same ratio as your paycheck withholding. If your last vest was
            withheld at different rates, enter them here instead.
          </p>
          <div class="pct-pair">
            <label class="field">
              <span class="field-label">Last vest: % withheld for federal <span class="opt">Optional</span></span>
              <span class="money pct"><input type="number" id="vest-fed-pct" min="0" max="100" step="0.1" placeholder="40" /><span class="suffix">%</span></span>
            </label>
            <label class="field">
              <span class="field-label">% withheld for CA <span class="opt">Optional</span></span>
              <span class="money pct"><input type="number" id="vest-ca-pct" min="0" max="100" step="0.1" placeholder="10" /><span class="suffix">%</span></span>
            </label>
          </div>
        </div>

        <div id="vest-list">
          <div class="vest-row">
            <input type="date" class="vest-date" aria-label="Vest date" />
            <span class="money grow"><span class="prefix">$</span><input type="number" class="vest-amount" min="0" step="0.01" placeholder="0.00" aria-label="Vest amount" /></span>
            <button type="button" class="icon-btn remove-vest" aria-label="Remove vest">×</button>
          </div>
        </div>

        <button type="button" class="btn" id="add-vest">+ Add another vest</button>

        <label class="field">
          <span class="field-label">Stock price variance</span>
          <span class="money pct"><input type="number" id="variance-pct" min="0" max="100" step="1" value="20" /><span class="suffix">±%</span></span>
          <span class="muted small">Results will show a range assuming vest values could come in ± this much.</span>
        </label>

        <p class="error hidden" id="err-4"></p>
        <div class="nav">
          <button type="button" class="btn nav-back">Back</button>
          <button type="button" class="btn primary nav-next">Calculate my results</button>
        </div>
      </section>

      <section class="step card hidden" data-title="Results">
        <div id="results-content"></div>
      </section>
    </main>

    <script>
      import { calculate, type EstimatorInput, type FilingStatus } from '../lib/tax2026';

      const steps = Array.from(document.querySelectorAll<HTMLElement>('.step'));
      const TOTAL_SECTIONS = 4;
      let current = 0;

      const usdFmt = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
      const usd = (n: number) => usdFmt.format(Math.round(n));
      const pct = (r: number) => (r * 100).toFixed(r * 100 % 1 === 0 ? 0 : 1) + '%';

      function choice(name: string): string | null {
        const el = document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
        return el ? el.value : null;
      }
      function num(id: string): number {
        const el = document.getElementById(id) as HTMLInputElement | null;
        if (!el || el.value.trim() === '') return NaN;
        return parseFloat(el.value.replace(/[$,\s]/g, ''));
      }
      function numOr0(id: string): number {
        const v = num(id);
        return Number.isFinite(v) ? v : 0;
      }
      function optNum(id: string): number | undefined {
        const el = document.getElementById(id) as HTMLInputElement | null;
        if (!el || el.value.trim() === '') return undefined;
        const v = parseFloat(el.value);
        return Number.isFinite(v) ? v : undefined;
      }
      function filingStatus(): FilingStatus | null {
        const v = (document.getElementById('filing-status') as HTMLSelectElement).value;
        return (v || null) as FilingStatus | null;
      }
      function setError(step: number, msg: string | null) {
        const el = document.getElementById(`err-${step}`)!;
        el.textContent = msg ?? '';
        el.classList.toggle('hidden', !msg);
      }
      function show(i: number) {
        current = i;
        steps.forEach((s, idx) => s.classList.toggle('hidden', idx !== i));
        const label = document.getElementById('progress-label')!;
        const fill = document.getElementById('progress-fill')!;
        if (i === 0) {
          label.textContent = 'Get started';
          fill.style.width = '0%';
        } else if (i >= steps.length - 1) {
          label.textContent = 'Results';
          fill.style.width = '100%';
        } else {
          label.textContent = `Step ${i} of ${TOTAL_SECTIONS} · ${steps[i].dataset.title}`;
          fill.style.width = `${(i / (TOTAL_SECTIONS + 1)) * 100}%`;
        }
        window.scrollTo({ top: 0 });
      }

      function validateStep(n: number): string | null {
        if (n === 1) {
          for (const g of ['age65', 'blind', 'dependents', 'isDependent']) {
            if (!choice(g)) return 'Please answer every required question.';
          }
          const status = filingStatus();
          if (!status) return 'Please choose a filing status.';
          if (choice('dependents') === 'yes') {
            const c = numOr0('children-under17');
            const o = numOr0('other-dependents');
            if (c < 0 || o < 0 || c + o < 1) {
              return 'Enter how many dependents you plan to claim (at least 1 total).';
            }
          }
          if (status === 'mfj') {
            for (const g of ['s_age65', 's_blind', 's_dependent']) {
              if (!choice(g)) return 'Please answer every required question about your spouse.';
            }
          }
          return null;
        }
        if (n === 2) {
          for (const id of ['ytd-gross', 'ytd-ca', 'ytd-fed']) {
            const v = num(id);
            if (!Number.isFinite(v) || v < 0) return 'Enter all three year-to-date amounts (0 or more).';
          }
          return null;
        }
        if (n === 3) {
          const lastPay = (document.getElementById('last-pay-date') as HTMLInputElement).value;
          if (!lastPay) return 'Enter the date you were last paid.';
          const lp = new Date(lastPay + 'T00:00:00');
          const today = new Date();
          today.setHours(0, 0, 0, 0);
          if (Number.isNaN(lp.getTime()) || lp > today) return 'Last pay date must be today or earlier.';
          const freq = (document.getElementById('pay-freq') as HTMLSelectElement).value;
          if (!freq) return 'Choose your pay frequency.';
          const gross = num('gross-per-period');
          if (!Number.isFinite(gross) || gross <= 0) return 'Enter your gross pay per paycheck.';
          for (const id of ['fed-wh-per-period', 'ca-wh-per-period']) {
            const v = num(id);
            if (!Number.isFinite(v) || v < 0) return 'Enter the tax withheld per paycheck (0 or more).';
          }
          return null;
        }
        if (n === 4) {
          for (const row of Array.from(document.querySelectorAll<HTMLElement>('.vest-row'))) {
            const date = (row.querySelector('.vest-date') as HTMLInputElement).value;
            const amount = parseFloat((row.querySelector('.vest-amount') as HTMLInputElement).value);
            const hasDate = date !== '';
            const hasAmount = Number.isFinite(amount) && amount > 0;
            if (hasDate !== hasAmount) return 'Each vest needs both a date and a dollar amount.';
            if (hasAmount && amount < 0) return 'Vest amounts must be 0 or more.';
          }
          const vf = document.getElementById('vest-fed-pct') as HTMLInputElement;
          const vc = document.getElementById('vest-ca-pct') as HTMLInputElement;
          if ((vf.value.trim() !== '') !== (vc.value.trim() !== '')) {
            return 'Enter both federal and CA percentages from your last vest, or leave both blank.';
          }
          for (const el of [vf, vc]) {
            if (el.value.trim() === '') continue;
            const v = parseFloat(el.value);
            if (!Number.isFinite(v) || v < 0 || v > 100) return 'Vest withholding percentages must be between 0 and 100.';
          }
          return null;
        }
        return null;
      }

      function collect(): EstimatorInput {
        const status = filingStatus()!;
        const claimingDependents = choice('dependents') === 'yes';
        const vests = Array.from(document.querySelectorAll<HTMLElement>('.vest-row'))
          .map((row) => ({
            date: (row.querySelector('.vest-date') as HTMLInputElement).value,
            amount: parseFloat((row.querySelector('.vest-amount') as HTMLInputElement).value) || 0,
          }))
          .filter((v) => v.date && v.amount > 0)
          .sort((a, b) => a.date.localeCompare(b.date));
        return {
          status,
          flags: { age65: choice('age65') === 'yes', blind: choice('blind') === 'yes' },
          spouseFlags: { age65: choice('s_age65') === 'yes', blind: choice('s_blind') === 'yes' },
          claimingDependents,
          childrenUnder17: claimingDependents ? num('children-under17') || 0 : 0,
          otherDependents: claimingDependents ? num('other-dependents') || 0 : 0,
          isDependent: choice('isDependent') === 'yes',
          ytdGross: num('ytd-gross'),
          ytdFederalWithheld: num('ytd-fed'),
          ytdCaWithheld: num('ytd-ca'),
          frequency: (document.getElementById('pay-freq') as HTMLSelectElement).value as 'weekly' | 'biweekly' | 'monthly',
          lastPayDate: (document.getElementById('last-pay-date') as HTMLInputElement).value,
          grossPerPeriod: num('gross-per-period'),
          federalWhPerPeriod: num('fed-wh-per-period'),
          caWhPerPeriod: num('ca-wh-per-period'),
          vests,
          variancePct: numOr0('variance-pct'),
          vestFederalPct: optNum('vest-fed-pct'),
          vestCaPct: optNum('vest-ca-pct'),
          now: new Date(),
        };
      }

      function outcomeBadge(gap: number): string {
        if (Math.abs(gap) <= 25) return '<span class="badge ok">On track</span>';
        if (gap > 0) return `<span class="badge over">Overpaid by ${usd(gap)}</span>`;
        return `<span class="badge under">Underpaid by ${usd(-gap)}</span>`;
      }
      function describeGap(gap: number): string {
        if (Math.abs(gap) <= 25) return 'on track';
        if (gap > 0) return `overwithheld by ${usd(gap)}`;
        return `underwithheld by ${usd(-gap)}`;
      }

      function federalLevers(gap: number, periods: number, marginal: number): string {
        if (Math.abs(gap) <= 25) return 'No changes needed — keep withholding as-is.';
        if (gap < 0) {
          const under = Math.ceil(-gap);
          const per = periods > 0 ? Math.ceil(under / periods) : under;
          return `<ul class="levers">
            <li>Add <b>${usd(per)}</b> to W-4 Step 4(c) “Extra withholding” for each of your <b>${periods}</b> remaining paycheck${periods === 1 ? '' : 's'}, or</li>
            <li>Withhold an extra <b>${usd(under)}</b> total before year-end (e.g. on your final paycheck).</li>
          </ul>`;
        }
        const over = Math.round(gap);
        if (marginal <= 0) {
          return `<ul class="levers"><li>Your taxable income is already $0, so deductions can't reduce withholding further. Set any W-4 Step 4(c) “Extra withholding” to $0.</li></ul>`;
        }
        const ded = Math.round(over / marginal);
        return `<ul class="levers">
          <li>Enter about <b>${usd(ded)}</b> in W-4 Step 4(b) “Deductions” — at your ${pct(marginal)} marginal rate this reduces your withholding by roughly <b>${usd(over)}</b> across the year, or</li>
          <li>Reduce any W-4 Step 4(c) “Extra withholding” to $0.</li>
        </ul>`;
      }

      function stateLevers(gap: number, periods: number, marginal: number): string {
        if (Math.abs(gap) <= 25) return 'No changes needed — keep withholding as-is.';
        if (gap < 0) {
          const under = Math.ceil(-gap);
          const per = periods > 0 ? Math.ceil(under / periods) : under;
          return `<ul class="levers">
            <li>Add <b>${usd(per)}</b> to the “Additional amount, per payroll period” line on your CA DE-4 for each of your <b>${periods}</b> remaining paycheck${periods === 1 ? '' : 's'}, or</li>
            <li>Withhold an extra <b>${usd(under)}</b> total before year-end.</li>
          </ul>`;
        }
        const over = Math.round(gap);
        if (marginal <= 0) {
          return `<ul class="levers"><li>Your CA taxable income is already $0. Reduce any DE-4 “Additional amount” to $0.</li></ul>`;
        }
        const ded = Math.round(over / marginal);
        return `<ul class="levers">
          <li>Claim about <b>${usd(ded)}</b> as “Estimated deductions” on your CA DE-4 — at your ${pct(marginal)} CA marginal rate this reduces withholding by roughly <b>${usd(over)}</b>, or</li>
          <li>Reduce any DE-4 “Additional amount” to $0.</li>
        </ul>`;
      }

      function kv(label: string, value: string): string {
        return `<div class="kv"><span>${label}</span><b>${value}</b></div>`;
      }

      function renderResults() {
        const input = collect();
        const r = calculate(input);
        const fedGap = r.base.projectedFederalWithheld - r.base.fed.net;
        const caGap = r.base.projectedCaWithheld - r.base.ca.net;
        const fedLowGap = r.low.projectedFederalWithheld - r.low.fed.net;
        const fedHighGap = r.high.projectedFederalWithheld - r.high.fed.net;
        const caLowGap = r.low.projectedCaWithheld - r.low.ca.net;
        const caHighGap = r.high.projectedCaWithheld - r.high.ca.net;

        const vestLine = r.vestTotal > 0
          ? `${usd(r.vestTotal)} (range ${usd(r.vestLow)}–${usd(r.vestHigh)})`
          : '$0';

        document.getElementById('results-content')!.innerHTML = `
          <h2>Your 2026 Projection</h2>
          <p class="muted">Projected through December 31, 2026, assuming your paycheck stays the same.</p>

          <div class="result-card overview">
            <h3>Overview</h3>
            ${kv('Projected gross income', usd(r.base.grossIncome))}
            ${kv('· from upcoming vests', vestLine)}
            ${r.vestTotal > 0 ? kv('· est. withheld at vests', `${usd(r.base.vestWithheldFederal)} fed · ${usd(r.base.vestWithheldCa)} CA (${pct(r.vestFederalPct)} / ${pct(r.vestCaPct)})`) : ''}
            ${kv('Remaining paychecks this year', String(r.remainingPeriods))}
            ${kv('Projected federal income tax withheld', usd(r.base.projectedFederalWithheld))}
            ${kv('Projected CA income tax withheld', usd(r.base.projectedCaWithheld))}
          </div>

          <div class="result-card">
            <div class="card-head"><h3>Federal</h3>${outcomeBadge(fedGap)}</div>
            ${kv('Projected 2026 federal income tax liability', usd(r.base.fed.net))}
            ${kv('Projected federal withholding', usd(r.projectedFederalWithheld))}
            ${kv('Marginal tax rate', pct(r.base.fed.marginal))}
            <div class="lever-box">
              <h4>How to adjust (W-4)</h4>
              ${federalLevers(fedGap, r.remainingPeriods, r.base.fed.marginal)}
            </div>
          </div>

          <div class="result-card">
            <div class="card-head"><h3>California</h3>${outcomeBadge(caGap)}</div>
            ${kv('Projected 2026 CA income tax liability', usd(r.base.ca.net))}
            ${kv('Projected CA withholding', usd(r.projectedCaWithheld))}
            ${kv('Marginal tax rate', pct(r.base.ca.marginal))}
            <div class="lever-box">
              <h4>How to adjust (CA DE-4)</h4>
              ${stateLevers(caGap, r.remainingPeriods, r.base.ca.marginal)}
            </div>
          </div>

          ${r.vestTotal > 0 ? `
          <div class="result-card range">
            <h3>Stock variance range (±${input.variancePct}%)</h3>
            <p class="muted">Vest withholding scales with the range too. If your vests come in low: federal ends up <b>${describeGap(fedLowGap)}</b>, CA <b>${describeGap(caLowGap)}</b>.<br/>
            If your vests come in high: federal ends up <b>${describeGap(fedHighGap)}</b>, CA <b>${describeGap(caHighGap)}</b>.</p>
          </div>` : ''}

          <details class="assumptions">
            <summary>Assumptions &amp; methodology</summary>
            <ul>
              <li>Uses the 2026 federal and CA brackets, standard deductions, CTC ($2,200/child, $1,700 refundable, phase-outs at $200k/$400k MAGI), $500 other-dependent credit, and the 1% CA mental health tax over $1M.</li>
              <li>Senior bonus deduction of $6,000/person (phased out 6% above $75k/$150k MAGI) and $1,600 ($800 MFS) additional standard deduction per 65+/blind condition are included.</li>
              <li>Head of Household is taxed on the Single schedule and Qualified Surviving Spouse on the MFJ schedule; CA exemption credits (personal/dependent/senior/blind) are estimates pending FTB 2026 figures.</li>
              <li>Withholding is assumed constant at your current per-paycheck amounts; remaining paychecks are counted forward from your last pay date through December 31, 2026.</li>
              <li>Vests are treated as ordinary compensation in 2026. We assume 40% of each vest is withheld at vesting (split by your paycheck federal/CA ratio, or your custom last-vest percentages), and that withholding scales with the ±variance range.</li>
              <li>Social Security wage base ($184,500) affects FICA, not income-tax withholding, so it's excluded from the over/under comparison. Itemized deductions (incl. the $40,400 SALT cap) aren't modeled — the standard deduction is used.</li>
            </ul>
          </details>

          <div class="nav">
            <button type="button" class="btn" id="restart-btn">Start over</button>
          </div>
          <p class="muted small disclaimer">Estimates only, not tax advice.</p>
        `;

        document.getElementById('restart-btn')?.addEventListener('click', () => location.reload());
      }

      document.getElementById('start-btn')!.addEventListener('click', () => show(1));
      document.querySelectorAll('.nav-next').forEach((b) =>
        b.addEventListener('click', () => {
          setError(current, null);
          const err = validateStep(current);
          if (err) {
            setError(current, err);
            return;
          }
          if (current === steps.length - 2) renderResults();
          show(current + 1);
        })
      );
      document.querySelectorAll('.nav-back').forEach((b) =>
        b.addEventListener('click', () => show(current - 1))
      );

      const statusSelect = document.getElementById('filing-status') as HTMLSelectElement;
      const toggleSpouse = () => {
        document.getElementById('spouse-block')!.classList.toggle('hidden', statusSelect.value !== 'mfj');
      };
      statusSelect.addEventListener('change', toggleSpouse);

      const toggleDeps = () => {
        document.getElementById('dependents-block')!.classList.toggle('hidden', choice('dependents') !== 'yes');
      };
      document.querySelectorAll<HTMLInputElement>('input[name="dependents"]').forEach((r) =>
        r.addEventListener('change', toggleDeps)
      );

      const vestList = document.getElementById('vest-list')!;
      const setMinDates = () => {
        const today = new Date().toISOString().slice(0, 10);
        vestList.querySelectorAll<HTMLInputElement>('.vest-date').forEach((d) => (d.min = today));
        const lp = document.getElementById('last-pay-date') as HTMLInputElement | null;
        if (lp) lp.max = today;
      };
      setMinDates();
      document.getElementById('add-vest')!.addEventListener('click', () => {
        const row = vestList.querySelector('.vest-row')!.cloneNode(true) as HTMLElement;
        row.querySelectorAll('input').forEach((i) => ((i as HTMLInputElement).value = ''));
        vestList.appendChild(row);
        setMinDates();
      });
      vestList.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.remove-vest');
        if (!btn) return;
        const rows = vestList.querySelectorAll('.vest-row');
        if (rows.length > 1) {
          (btn as HTMLElement).closest('.vest-row')!.remove();
        } else {
          rows[0].querySelectorAll('input').forEach((i) => ((i as HTMLInputElement).value = ''));
        }
      });

      show(0);
    </script>

    <style>
      :root {
        --accent: #2563eb;
        --bg: #f5f6f8;
        --card: #ffffff;
        --border: #e4e4e7;
        --text: #18181b;
        --muted: #71717a;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background: var(--bg);
        color: var(--text);
      }
      main { max-width: 640px; margin: 0 auto; padding: 32px 16px 64px; }
      .progress-wrap { margin-bottom: 20px; }
      .progress-label {
        font-size: 12px; font-weight: 700; color: var(--muted);
        margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;
      }
      .progress-track { height: 6px; background: var(--border); border-radius: 999px; overflow: hidden; }
      .progress-fill { height: 100%; width: 0; background: var(--accent); border-radius: 999px; transition: width 0.3s ease; }
      .card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 28px; }
      .hidden { display: none; }
      h1 { font-size: 26px; margin: 0 0 12px; line-height: 1.25; }
      h2 { font-size: 21px; margin: 0 0 6px; }
      h3 { font-size: 15px; margin: 0 0 4px; }
      h4 { font-size: 13px; margin: 0 0 6px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
      p { line-height: 1.55; margin: 8px 0; }
      .muted { color: var(--muted); font-size: 14px; }
      .small { font-size: 12.5px; }
      .optional {
        display: inline-block; font-size: 11px; font-weight: 700; color: var(--muted);
        border: 1px solid var(--border); border-radius: 999px; padding: 2px 10px;
        vertical-align: middle; margin-left: 8px; text-transform: uppercase; letter-spacing: 0.04em;
      }
      .req {
        display: inline-block; font-size: 10.5px; font-weight: 700; color: #b45309;
        background: #fef3c7; border-radius: 999px; padding: 2px 8px;
        vertical-align: middle; margin-left: 6px; text-transform: uppercase; letter-spacing: 0.03em;
      }
      fieldset.q { border: 0; padding: 0; margin: 22px 0 0; min-width: 0; }
      legend { font-weight: 600; font-size: 15px; padding: 0; margin-bottom: 10px; line-height: 1.4; }
      .choice { display: flex; flex-wrap: wrap; gap: 8px; }
      .choice label {
        position: relative; border: 1px solid var(--border); border-radius: 999px;
        padding: 8px 18px; cursor: pointer; font-size: 14px; background: #fff;
      }
      .choice input { position: absolute; inset: 0; opacity: 0; margin: 0; }
      .choice label:has(input:checked) { background: var(--accent); border-color: var(--accent); color: #fff; }
      .choice label:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
      .hint { margin: 0 0 10px; font-size: 13.5px; }
      .hint summary { color: var(--accent); cursor: pointer; font-size: 13px; }
      .hint p { color: var(--muted); font-size: 13px; }
      .sub-block { margin-top: 14px; padding: 16px; background: #f8fafc; border: 1px solid var(--border); border-radius: 10px; }
      .sub-title { font-weight: 600; font-size: 14px; margin: 0 0 4px; }
      .opt {
        display: inline-block; font-size: 10.5px; font-weight: 700; color: var(--muted);
        border: 1px solid var(--border); border-radius: 999px; padding: 2px 8px;
        vertical-align: middle; margin-left: 6px; text-transform: uppercase; letter-spacing: 0.03em;
      }
      .pct-pair { display: flex; gap: 12px; margin-top: 4px; }
      .pct-pair .field { flex: 1; margin-top: 8px; }
      .spouse-note { font-size: 14px; color: var(--muted); margin: 0 0 4px; }
      .field { display: block; margin-top: 16px; }
      .field-label { display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px; }
      input[type='text'], input[type='number'], input[type='date'], select {
        width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px;
        font: inherit; background: #fff; color: var(--text);
      }
      input:focus, select:focus { outline: 2px solid var(--accent); outline-offset: 0; border-color: var(--accent); }
      .money { position: relative; display: block; }
      .money .prefix { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--muted); }
      .money input { padding-left: 27px; }
      .money.pct { display: flex; align-items: center; gap: 8px; }
      .money.pct input { width: 110px; }
      .money.pct .suffix { color: var(--muted); font-weight: 600; }
      .nav { display: flex; gap: 10px; margin-top: 26px; justify-content: space-between; }
      .btn {
        padding: 10px 20px; border-radius: 10px; border: 1px solid var(--border);
        background: #fff; font: inherit; font-weight: 600; cursor: pointer;
      }
      .btn:hover { border-color: #c8c8ce; }
      .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
      .btn.primary:hover { background: #1d4fd7; }
      .error { color: #dc2626; font-size: 14px; font-weight: 500; margin-top: 14px; }
      .vest-row { display: flex; gap: 8px; align-items: center; margin-top: 10px; }
      .vest-row input[type='date'] { flex: 1.2; }
      .vest-row .grow { flex: 1; }
      .icon-btn {
        border: 1px solid var(--border); background: #fff; border-radius: 8px;
        width: 38px; height: 40px; font-size: 18px; cursor: pointer; flex-shrink: 0;
      }
      .icon-btn:hover { border-color: #dc2626; color: #dc2626; }
      #add-vest { margin-top: 12px; font-size: 14px; }
      .result-card { margin-top: 16px; padding: 20px; border: 1px solid var(--border); border-radius: 12px; background: #fff; }
      .result-card.overview { background: #f8fafc; }
      .card-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 6px; }
      .kv { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px dashed var(--border); font-size: 14px; }
      .kv:last-child { border-bottom: 0; }
      .badge { display: inline-block; padding: 4px 12px; border-radius: 999px; font-size: 13px; font-weight: 700; white-space: nowrap; }
      .badge.over { background: #dcfce7; color: #166534; }
      .badge.under { background: #fee2e2; color: #991b1b; }
      .badge.ok { background: #e0e7ff; color: #3730a3; }
      .lever-box { margin-top: 12px; padding: 14px; background: #f8fafc; border: 1px solid var(--border); border-radius: 10px; }
      .levers { margin: 4px 0 0; padding-left: 18px; }
      .levers li { margin: 6px 0; font-size: 14px; line-height: 1.5; }
      .assumptions { margin-top: 16px; font-size: 13.5px; }
      .assumptions summary { color: var(--accent); cursor: pointer; font-weight: 600; }
      .assumptions ul { color: var(--muted); padding-left: 18px; }
      .assumptions li { margin: 6px 0; line-height: 1.5; }
      .disclaimer { margin-top: 16px; text-align: center; }
      @media (max-width: 480px) {
        .card { padding: 20px; }
        .vest-row { flex-wrap: wrap; }
      }
    </style>
  </body>
</html>
